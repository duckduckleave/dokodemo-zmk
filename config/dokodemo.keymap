// ZMK includes
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/behaviors.h>


// Layers
#define U_BASE 0
#define U_NAV 1
#define U_MOUSE 2
#define U_MEDIA 3
#define U_NUM 4
#define U_SYM 5
#define U_FUN 6


// Clipboard - Custom keycodes
// If define statment has "&", don't add "&" in the mapping.
#define U_RDO &kp LS(LG(Z))
#define U_PST &kp LG(V)
#define U_CPY &kp LG(C)
#define U_CUT &kp LG(X)
#define U_UND &kp LG(Z)


// Mousekeys
#define ZMK_POINTING_DEFAULT_MOVE_VAL 700 // 1250 (Per Miryoku's settings)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20 // 100 (Per Miryoku's settings)

#include <dt-bindings/zmk/pointing.h>

#define U_BTN1 &mkp MB1
#define U_BTN2 &mkp MB2
#define U_BTN3 &mkp MB3

#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_MS_U &mmv MOVE_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT
#define U_WH_U &msc SCRL_UP


// Mouse behaviour
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};


// Macros - Bluetooth
/ {
    macros {
        u_macro_bt_sel_0: u_macro_bt_sel_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 0 &bt BT_CLR>;
        };
        u_macro_bt_sel_1: u_macro_bt_sel_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 1 &bt BT_CLR>;
        };
        u_macro_bt_sel_2: u_macro_bt_sel_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 2 &bt BT_CLR>;
        };
        u_macro_bt_sel_3: u_macro_bt_sel_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings = <&bt BT_SEL 3 &bt BT_CLR>;
        };
    };
};


// Behaviours
/ {
    behaviors {
        // urob-style timeless homerow mods
        // Regular mod tap and layer tap wasn't cutting it as inputting multiple HRM combos is finnicky.
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>; // 200
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>; // 150
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
        // mod tap and layer tap
        // mod tap behaviour not in use
        /*mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };*/
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced"; // Tap preferred
            tapping-term-ms = <200>;
            quick-tap-ms = <175>; // Implemented urob's global quick tap
            bindings = <&mo>, <&kp>;
        };
        // Bluetooth
        u_bt_sel_0: u_bt_sel_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&u_macro_bt_sel_0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_1: u_bt_sel_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&u_macro_bt_sel_1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_2: u_bt_sel_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 2>, <&u_macro_bt_sel_2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        u_bt_sel_3: u_bt_sel_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 3>, <&u_macro_bt_sel_3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        // Caps word
        u_caps_word: u_caps_word {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};


// Thumbcombos
#define THUMB_LEFT 30 31
#define THUMB_RIGHT 32 33

/ {
    combos {
        compatible = "zmk,combos";
        combo_base_left {
            layers = <U_BASE>;
            timeout-ms = <200>;
            key-positions = <THUMB_LEFT>;
            bindings = <&lt U_MEDIA ESC>;
        };
        combo_num_left {
            layers = <U_NUM>;
            timeout-ms = <200>;
            key-positions = <THUMB_LEFT>;
            bindings = <&kp DOT>;
        };
        combo_sym_left {
            layers = <U_SYM>;
            timeout-ms = <200>;
            key-positions = <THUMB_LEFT>;
            bindings = <&kp LPAR>;
        };
        combo_fun_left {
            layers = <U_FUN>;
            timeout-ms = <200>;
            key-positions = <THUMB_LEFT>;
            bindings = <&kp K_APP>;
        };
        combo_base_right {
            layers = <U_BASE>;
            timeout-ms = <200>;
            key-positions = <THUMB_RIGHT>;
            bindings = <&lt U_FUN DEL>;
        };
        combo_nav_right {
            layers = <U_NAV>;
            timeout-ms = <200>;
            key-positions = <THUMB_RIGHT>;
            bindings = <&kp DEL>;
        };
        combo_mouse_right {
            layers = <U_MOUSE>;
            timeout-ms = <200>;
            key-positions = <THUMB_RIGHT>;
            bindings = <U_BTN3>;
        };
        combo_media_right {
            layers = <U_MEDIA>;
            timeout-ms = <200>;
            key-positions = <THUMB_RIGHT>;
            bindings = <&kp C_MUTE>;
        };
    };
};


// Keymap
/{
    keymap {
        compatible = "zmk,keymap";
        U_BASE {
            display-name = "Default Layer";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &kp Q      &kp W      &kp F      &kp P      &kp G          &kp J      &kp L      &kp U      &kp Y      &kp SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &hm LGUI A  &hm LALT R  &hm LCTRL S &hm LSHFT T &kp D      &kp H      &hm LSHFT N &hm LCTRL E &hm LALT I &hm LGUI O
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp Z      &kp X      &kp C      &kp V      &kp B          &kp K      &kp M      &kp COMMA  &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                            &lt U_NAV SPACE &lt U_MOUSE TAB &lt U_SYM RET &lt U_NUM BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_NAV {
            display-name = "Navigation";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &none      &none      &none       &none      &none          U_RDO      U_PST      U_CPY      U_CUT      U_UND
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &none      &none      &none       &none      &none       &u_caps_word  &kp LEFT  &kp DOWN   &kp UP  &kp RIGHT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
           &none      &none      &none       &none      &none         &kp INS  &kp HOME  &kp PG_DN    &kp PG_UP    &kp END
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &kp ESC        &kp RET   &kp BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_MOUSE {
            display-name = "Mouse";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &none      &none       &none     &none      &none           U_RDO      U_PST      U_CPY      U_CUT      U_UND
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &none      &none       &none     &none      &none           &none     U_MS_L     U_MS_D     U_MS_U     U_MS_R
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &none      &none       &none     &none      &none          &none      U_WH_L     U_WH_D     U_WH_U     U_WH_R
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         U_BTN2      U_BTN1
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_MEDIA {
            display-name = "Media";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &none      &none       &none     &none      &none          &none     &kp C_BRI_UP  &kp C_BRI_DN    &none    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &none      &none       &none     &none      &none         &kp C_MUTE   &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &none      &none       &none     &none      &none         &none    &u_bt_sel_0 &u_bt_sel_1 &u_bt_sel_2 &u_bt_sel_3
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &none      &none          &kp C_STOP   &kp C_PP
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_NUM {
            display-name = "Number";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &kp LBKT     &kp N7    &kp N8    &kp N9     &kp RBKT        &none      &none    &none     &kp GRAVE   &kp BSLH
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp SEMI    &kp N4    &kp N5     &kp N6     &kp EQUAL       &none     &kp LEFT   &kp DOWN    &kp UP    &kp RIGHT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp COMMA   &kp N1    &kp N2    &kp N3      &kp PLUS        &none      &none    &kp COMMA   &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp N0     &kp MINUS       &none      &none
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_SYM {
            display-name = "Symbol";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &kp LBRC    &kp AMPS   &kp ASTRK  &kp LPAR  &kp RBRC        &none      &none       &none     &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp COLON   &kp DLLR   &kp PRCNT  &kp CARET &kp PLUS       &none      &kp LSHFT  &kp LCTRL   &kp LALT  &kp LGUI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp TILDE   &kp EXCL   &kp AT     &kp HASH  &kp PIPE        &none      &none       &none     &none      &none
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp RPAR   &kp UNDER       &none      &none
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        U_FUN {
            display-name = "Function";
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
            &kp F12     &kp F7     &kp F8     &kp F9     &kp PSCRN      &none      &none       &none     &none      &none
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp F11     &kp F4     &kp F5     &kp F6     &kp SLCK       &none      &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
            &kp F10     &kp F1     &kp F2     &kp F3     &kp PAUSE_BREAK  &none      &none       &none     &none      &none
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &kp SPACE   &kp TAB          &none      &none
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
